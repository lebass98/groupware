rules_version = '2';

/**
 * WnC 그룹웨어 Firestore 보안 규칙
 *
 * 이 앱은 GitHub Pages로 배포되는 정적 사이트라 서버 검증 계층이 없습니다.
 * 따라서 이 규칙 파일이 데이터베이스를 지키는 유일한 방어선입니다.
 * 임직원 연락처 등 개인정보가 포함되어 있으므로 비로그인 공개 읽기를 절대 허용하지 않습니다.
 *
 * 콘솔 적용 경로: Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 관리자 판별: admins 컬렉션에 본인 UID 문서가 존재하는 계정만 마스터 데이터를 쓸 수 있습니다.
    // 콘솔에서 admins/{UID} 문서를 직접 생성하여 지정합니다.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 개인 상태 문서(근태, 할일, 연차, 결재, 경비 등 기기 간 동기화 대상)
    // 본인 것만 읽고 쓸 수 있습니다.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 관리자 지정 문서는 조회만 가능하고 클라이언트에서 수정할 수 없습니다.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 전사 마스터 데이터: 로그인한 임직원은 읽기만, 변경은 관리자만 가능합니다.
    match /employees/{docId}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notices/{docId}         { allow read: if signedIn(); allow write: if isAdmin(); }
    match /todos/{docId}           { allow read: if signedIn(); allow write: if isAdmin(); }
    match /schedules/{docId}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /attendance/{docId}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /attendance_logs/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /finance/{docId}         { allow read: if signedIn(); allow write: if isAdmin(); }

    // 위에서 명시하지 않은 모든 경로는 기본 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
